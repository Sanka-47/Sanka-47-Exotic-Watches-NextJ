# --- Database -------------------------------------------------------------
# MySQL connection string used by Prisma.
DATABASE_URL="mysql://user:password@localhost:3306/exotica_watches"

# --- Authentication (Auth.js / NextAuth v5) --------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of e-mail addresses that get the ADMIN role on sign-up.
ADMIN_EMAILS="you@example.com"

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder created in your Cloudinary account for product images.
CLOUDINARY_UPLOAD_FOLDER="exotica-watches"

# --- Stripe ----------------------------------------------------------------
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_..."
# Created with: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
